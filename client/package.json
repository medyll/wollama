{
	"name": "@wollama/client",
	"version": "0.0.9",
	"main": "electron/main.js",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5176 && electron .\"",
		"test:electron": "node --test electron/backend-manager.test.mjs electron/test-runtime.test.mjs",
		"smoke:electron": "node electron/smoke-packaged.mjs",
		"build:server": "node ../server/build-electron.mjs",
		"build:sidecar": "pyinstaller --clean --onefile --name chatterbox --distpath ./resources/extraResources ../packages/chatterbox/main.py",
		"package": "npm run build && npm run build:server && npm run build:sidecar && electron-builder"
	},
	"build": {
		"appId": "com.wollama.app",
		"productName": "Wollama",
		"directories": {
			"output": "dist_electron"
		},
		"files": [
			"build/**/*",
			"electron/**/*",
			"package.json"
		],
		"asarUnpack": [
			"electron/backend/**/*",
			"node_modules/ffmpeg-static/**/*"
		],
		"extraResources": [
			{
				"from": "resources/extraResources",
				"to": "extraResources",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "resources/wollama-server",
				"to": "wollama-server",
				"filter": [
					"**/*"
				]
			}
		],
		"win": {
			"target": "nsis"
		},
		"mac": {
			"target": "dmg"
		},
		"linux": {
			"target": "AppImage"
		}
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@medyll/css-base": "^0.7.15",
		"@tailwindcss/typography": "^0.5.20",
		"date-fns": "^4.4.0",
		"electron-serve": "^3.0.1",
		"ffmpeg-static": "^5.3.0",
		"highlight.js": "^11.12.0",
		"hljs": "^6.2.3",
		"idb": "^8.0.4",
		"marked": "^18.1.2",
		"marked-highlight": "^2.2.4",
		"prismjs": "^1.30.0",
		"rxdb": "^17.6.0",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@iconify/json": "^2.2.549",
		"@iconify/svelte": "^5.2.3",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/marked": "^6.0.0",
		"@types/pouchdb": "^6.4.2",
		"@vitest/coverage-v8": "^5.0.5",
		"concurrently": "^10.0.6",
		"electron": "^44.10.0",
		"electron-builder": "^26.18.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.32",
		"postcss-import": "^17.0.1",
		"postcss-nesting": "^14.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"publint": "^0.3.25",
		"sass": "^1.106.1",
		"sass-embedded": "^1.106.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wait-on": "^9.5.1"
	}
}
