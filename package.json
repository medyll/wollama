{
	"name": "wollama-monorepo",
	"version": "0.0.9",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"scripts": {
		"dev:client": "pnpm --filter @wollama/client dev",
		"dev:electron": "pnpm --filter @wollama/client electron:dev",
		"dev:server": "pnpm setup:python && pnpm setup:audio && pnpm --filter @wollama/server dev",
		"build": "pnpm --filter @wollama/client build",
		"check": "pnpm --filter @wollama/client check && pnpm --filter @wollama/server check",
		"test:client": "pnpm --filter @wollama/client test",
		"test:server": "pnpm --filter @wollama/server test:unit",
		"test:e2e-server": "pnpm --filter @wollama/server exec tsx --test ../client/e2e/fixtures/e2e-server.test.ts",
		"setup:python": "node setup-python.js",
		"setup:audio": "pnpm --filter @wollama/server setup:audio",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint . --fix",
		"release": "standard-version",
		"changelog": "standard-version --skip.bump --skip.commit --skip.tag"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"concurrently": "^10.0.5",
		"cz-customizable": "^7.5.4",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"standard-version": "^9.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-customizable"
		}
	}
}
